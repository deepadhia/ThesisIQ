# Copy to .env.local at the repo root. See README for migrations, admin seed, and optional features.
# Frontend (Vite): use .env.frontend.example for the VITE_* variables.

# Backend Database & Core Auth
DATABASE_URL=postgresql://user:password@host:port/database
JWT_SECRET=your_jwt_secret_key_here

# Server & Network URLs
PORT=4000
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:4000

# Initial Admin Seed Credentials
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=your_secure_admin_password

# External Market Data (Screener.in Session for Statutory Financials Ingestion)
SCREENER_SESSION_ID=
SCREENER_CSRF_TOKEN=

# AI & LLM Models (Transcription, Extractions & Reconciliation)
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Telegram Alerts & Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner API Token (Announcement Webhook / Cloudflare Dispatcher)
SCAN_API_TOKEN=

# GitHub Automation & Workflows (Cloudflare Dispatcher & Git Remote Sync)
GITHUB_PAT=

# Google Drive Audio & Filing Storage (Concall & AGM Transcripts)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_JSON_PATH=
# GOOGLE_DRIVE_OAUTH_TOKENS=

# Optional Supabase / Vite Variables for local full-stack run
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
